{
  "name": "@ygzhang-lab/vue-http",
  "version": "0.1.0",
  "description": "基于 Axios 的 Vue 3 插件化 HTTP 客户端：JWT / API Key 认证、无感刷新、Token 持久化与跨 Tab 同步、统一错误归一化",
  "keywords": [
    "vue",
    "vue3",
    "plugin",
    "axios",
    "http",
    "jwt",
    "ygzhang-lab"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
